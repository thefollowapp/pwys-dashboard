# Postgres connection string (production). Leave unset locally to fall back to SQLite (dev.db).
DATABASE_URL=postgresql+psycopg://user:password@host:5432/pwys_dashboard

# Long random string used to sign session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me

# Shared secret Make.com sends as "Authorization: Bearer <key>" when logging SMS/email events.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_API_KEY=change-me
